import os
import subprocess
from datetime import datetime

# Path to your local Git repository
REPO_PATH = r"C:\path\to\your\repository"  # Update with your repository path
LOG_FILE = "daily_log.txt"

def run_git_command(command, cwd):
    """Executes a git command using subprocess."""
    result = subprocess.run(command, cwd=cwd, text=True, capture_output=True)
    if result.returncode != 0:
        print(f"Error running {' '.join(command)}:\n{result.stderr}")
        return False
    print(result.stdout.strip())
    return True

def auto_commit():
    if not os.path.exists(REPO_PATH):
        print(f"Directory {REPO_PATH} does not exist.")
        return

    file_path = os.path.join(REPO_PATH, LOG_FILE)
    
    # Append current timestamp to log file
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(file_path, "a") as f:
        f.write(f"Daily log update: {now}\n")
    
    print(f"Updated {LOG_FILE} at {now}")

    # Git operations: stage, commit, and push
    if run_git_command(["git", "add", LOG_FILE], cwd=REPO_PATH):
        commit_message = f"chore: daily automated update [{now}]"
        if run_git_command(["git", "commit", "-m", commit_message], cwd=REPO_PATH):
            run_git_command(["git", "push"], cwd=REPO_PATH)

if __name__ == "__main__":
    auto_commit()
