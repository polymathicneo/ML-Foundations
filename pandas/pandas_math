import os
import subprocess
import numpy as np
import pandas as pd

# Path to your local Git repository
REPO_PATH = r"C:\path\to\your\repository"  # Update with your repository path
LOG_FILE = "activity_log.csv"

def run_git_command(command, cwd):
    """Executes a git command using subprocess."""
    result = subprocess.run(command, cwd=cwd, text=True, capture_output=True)
    if result.returncode != 0:
        print(f"Error running {' '.join(command)}:\n{result.stderr}")
        return False
    print(result.stdout.strip())
    return True

def generate_daily_entry():
    """Generates synthetic log data using NumPy and formats it with Pandas."""
    now = pd.Timestamp.now()
    
    # Generate random metrics using NumPy
    random_metrics = np.round(np.random.normal(loc=100, scale=15, size=3), 2)
    
    # Create a single-row DataFrame
    new_entry = pd.DataFrame([{
        "timestamp": now.strftime("%Y-%m-%d %H:%M:%S"),
        "metric_a": random_metrics[0],
        "metric_b": random_metrics[1],
        "score": random_metrics[2]
    }])
    
    return new_entry

def auto_commit():
    if not os.path.exists(REPO_PATH):
        print(f"Directory '{REPO_PATH}' does not exist.")
        return

    file_path = os.path.join(REPO_PATH, LOG_FILE)
    new_data = generate_daily_entry()

    # Append to existing CSV or create a new one with headers
    if os.path.exists(file_path):
        new_data.to_csv(file_path, mode="a", header=False, index=False)
    else:
        new_data.to_csv(file_path, mode="w", header=True, index=False)

    print(f"Logged new entry to {LOG_FILE}:")
    print(new_data.to_string(index=False))

    # Git operations: stage, commit, and push
    if run_git_command(["git", "add", LOG_FILE], cwd=REPO_PATH):
        timestamp_str = new_data["timestamp"].iloc[0]
        commit_message = f"chore: update daily data log [{timestamp_str}]"
        if run_git_command(["git", "commit", "-m", commit_message], cwd=REPO_PATH):
            run_git_command(["git", "push"], cwd=REPO_PATH)

if __name__ == "__main__":
    auto_commit()
